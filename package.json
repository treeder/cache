{
  "name": "cache",
  "version": "1.0.1",
  "description": "Generic, framework-agnostic caching library with storage adapters (Cloudflare KV, Memory), version manager, and SWR support.",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "keywords": [
    "cache",
    "caching",
    "swr",
    "cloudflare-kv",
    "memory-cache",
    "version-manager"
  ],
  "author": "@treeder",
  "license": "MIT",
  "devDependencies": {
    "vitest": "^3.0.5",
    "prettier": "^3.9.6"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 120,
    "bracketSameLine": true
  }
}
